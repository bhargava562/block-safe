# ============================================================
# BlockSafe .gitignore
# ============================================================

# ─── Environment & Secrets ──────────────────────────────────
.env
.env.local
.env.production
.env.staging
server/.env

# Keep .env.example (safe placeholder file)
!.env.example
!server/.env.example

# Secrets directories
**/secrets/

# ─── Python ─────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ─── Virtual Environments ──────────────────────────────────
venv/
env/
ENV/
.venv/
server/venv/

# ─── IDE / Editor ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Logs ───────────────────────────────────────────────────
*.log
logs/
blocksafe_test.log

# ─── Testing & Coverage ────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
test_results.xml

# ─── Temporary Files ───────────────────────────────────────
*.tmp
*.temp
temp/
tmp/

# ─── Audio Test Files ──────────────────────────────────────
*.wav
*.mp3
*.m4a
*.ogg
*.flac

# ─── CI/CD ──────────────────────────────────────────────────
.github/secrets/