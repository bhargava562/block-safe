# BlockSafe Environment Configuration (Example)
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ─────────────────────── REQUIRED ───────────────────────
# API Authentication Key (required)
# Used for X-API-KEY header validation
API_AUTH_KEY=your-secure-api-key-here

# ─────────────────────── AI API KEYS ───────────────────────
GROQ_API_KEY=your-groq-api-key-here

# ─────────────────────── OPTIONAL (ACT as Fallback if GROQ Fails) ───────────────────────
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ─────────────────────── SUPABASE (State) ───────────────
SUPABASE_URL=your-project-url.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# ─────────────────────── MODEL NAMES ────────────────────
GROQ_MODEL=llama-3.3-70b-versatile
DEEPSEEK_MODEL=deepseek-chat

# ─────────────────────── AUDIO (Phase 2 Voice Call) ──────────────────────────
# Maximum audio file size in MB (default: 10)
MAX_AUDIO_MB=10
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ─────────────────────── HONEYPOT Configuration ───────────────────────
HONEYPOT_MAX_TURNS=5
HONEYPOT_CONFIDENCE_THRESHOLD=0.85
HONEYPOT_NO_PROGRESS_TURNS=2

# ─────────────────────── PERFORMANCE TUNING ─────────────
# Bounded classification cache (prevents memory leaks)
CLASSIFICATION_CACHE_MAX=256
CLASSIFICATION_CACHE_TTL=300

# Concurrency & thread pool settings
MAX_CONCURRENT_REQUESTS=100
THREAD_POOL_WORKERS=4
REQUEST_TIMEOUT_SECONDS=30

# Rate limiter memory cap (max tracked clients)
RATE_LIMIT_MAX_CLIENTS=10000

# ─────────────────────── APPLICATION ────────────────────
APP_ENV=production
LOG_LEVEL=INFO
CORS_ORIGINS=*